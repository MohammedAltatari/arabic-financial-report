model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ServerName","DatabaseName","FactFinance","DimAccount","DimDepartment","DimOrganization","DimScenario","DimDate"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table FactFinance
ref table DimAccount
ref table DimDepartment
ref table DimOrganization
ref table DimScenario
ref table DimDate
ref table 'Forecast Cutoff'
ref table 'Variance Bridge'

ref cultureInfo en-US

