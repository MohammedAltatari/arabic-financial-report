	partition 'Variance Bridge' = calculated
		mode: import
		source =
				-- Budget-to-actual bridge for Operating Profit:
				-- row 0 = budgeted operating profit, then one row per Level-4 group under Operating Profit
				-- (Net Sales, Cost of Sales, Labor Expenses, Travel Expenses, ...), in income-statement order.
				VAR Groups =
				    CALCULATETABLE (
				        SUMMARIZE ( DimAccount, DimAccount[Level4Key], DimAccount[Level4Sort], DimAccount[Level4AR], DimAccount[Level4EN] ),
				        DimAccount[Level2EN] = "Operating Profit",
				        DimAccount[AccountDepth] >= 4
				    )
				RETURN
				    UNION (
				        ROW ( "BridgeKey", 0, "BridgeSort", 0, "BridgeAR", "الربح التشغيلي المخطط", "BridgeEN", "Budgeted Operating Profit" ),
				        SELECTCOLUMNS (
				            Groups,
				            "BridgeKey", DimAccount[Level4Key],
				            "BridgeSort", DimAccount[Level4Sort],
				            "BridgeAR", DimAccount[Level4AR],
				            "BridgeEN", DimAccount[Level4EN]
				        )
				    )

	annotation PBI_Id = 5d5e356e8d2b47949d6726f9e9db8759

