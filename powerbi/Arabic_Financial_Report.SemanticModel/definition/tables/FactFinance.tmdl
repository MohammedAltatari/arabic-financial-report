table FactFinance
	lineageTag: 019d620f-77a6-4a01-ab8f-0216afafaccd

	/// Actual amount in USD, signed (revenue +, costs -).
	measure Actual =
			CALCULATE (
			    SUM ( FactFinance[SignedAmountUSD] ),
			    DimScenario[ScenarioNameEN] = "Actual"
			)
		formatString: #,0;(#,0);-
		displayFolder: 1. Core
		lineageTag: c9ac38fe-e506-41f5-bd1a-1bfa20802504

	/// Budget amount in USD, signed (revenue +, costs -).
	measure Budget =
			CALCULATE (
			    SUM ( FactFinance[SignedAmountUSD] ),
			    DimScenario[ScenarioNameEN] = "Budget"
			)
		formatString: #,0;(#,0);-
		displayFolder: 1. Core
		lineageTag: 6dea5272-f6a6-43cd-af3b-517c839887f2

	/// Actual only for months that have a company budget (Dec 2010 - Nov 2011), regardless of account/department/branch filters.
	measure 'Actual (Budget Period)' =
			SUMX (
			    VALUES ( DimDate[YearMonthKey] ),
			    IF (
			        NOT ISBLANK (
			            CALCULATE (
			                [Budget],
			                ALL ( DimAccount ),
			                ALL ( DimDepartment ),
			                ALL ( DimOrganization )
			            )
			        ),
			        [Actual]
			    )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1. Core
		lineageTag: caeeeeb4-92de-4ade-afae-d342216ea42b

	/// Actual - Budget. Positive = Favorable, negative = Unfavorable (same rule for all lines).
	measure Variance =
			IF (
			    NOT ISBLANK ( [Budget] ),
			    [Actual (Budget Period)] - [Budget]
			)
		formatString: #,0;(#,0);-
		displayFolder: 2. Variance
		lineageTag: 2078357d-8481-49bf-97a8-e91f059a569c

	/// Variance / ABS(Budget), so the sign is not flipped for negative expense lines.
	measure 'Variance %' = DIVIDE ( [Variance], ABS ( [Budget] ) )
		formatString: 0.0%;(0.0%);-
		displayFolder: 2. Variance
		lineageTag: 441f5701-0333-4b83-b3d0-43178ae374c3

	/// Last closed month (YYYYMM) chosen in the 'Forecast Cutoff' slicer. Default: May 2011.
	measure 'Forecast Cutoff Key' = SELECTEDVALUE ( 'Forecast Cutoff'[CutoffKey], 201105 )
		formatString: 0
		displayFolder: 3. Forecast
		lineageTag: 20199f4f-6edc-4b7a-9ac8-bee762e5eda0

	/// Calculated forecast for the budget year: Actual for closed months (<= cutoff) + Budget for remaining months.
	measure 'Rolling Forecast' =
			VAR CutoffKey = [Forecast Cutoff Key]
			RETURN
			    SUMX (
			        VALUES ( DimDate[YearMonthKey] ),
			        VAR HasBudget =
			            NOT ISBLANK (
			                CALCULATE (
			                    [Budget],
			                    ALL ( DimAccount ),
			                    ALL ( DimDepartment ),
			                    ALL ( DimOrganization )
			                )
			            )
			        RETURN
			            IF (
			                HasBudget,
			                IF ( DimDate[YearMonthKey] <= CutoffKey, [Actual], [Budget] )
			            )
			    )
		formatString: #,0;(#,0);-
		displayFolder: 3. Forecast
		lineageTag: ee014a62-5e11-4e01-8c11-11bf7b2dd4bd

	/// Rolling Forecast - Budget: expected full-year gap vs plan. Positive = Favorable.
	measure 'Forecast Variance' =
			IF (
			    NOT ISBLANK ( [Budget] ),
			    [Rolling Forecast] - [Budget]
			)
		formatString: #,0;(#,0);-
		displayFolder: 3. Forecast
		lineageTag: b9f1c66f-5f82-4c60-bbcf-d7646df97e73

	/// Forecast Variance / ABS(Budget).
	measure 'Forecast Variance %' = DIVIDE ( [Forecast Variance], ABS ( [Budget] ) )
		formatString: 0.0%;(0.0%);-
		displayFolder: 3. Forecast
		lineageTag: 6d63692a-e71b-498d-86ac-2d06f99dc293

	/// Actual from 1 January to the last date in context (calendar year).
	measure 'Actual YTD' = CALCULATE ( [Actual], DATESYTD ( DimDate[Date] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4. Time Intelligence
		lineageTag: 45a50d8f-1eda-4a64-89da-8265ff137114

	/// Actual for the same period last year.
	measure 'Actual PY' = CALCULATE ( [Actual], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4. Time Intelligence
		lineageTag: f7a7e83f-8527-4138-ba86-7255e36feed2

	/// Actual - Actual PY. Blank when there is no prior-year data. Positive = better for profit.
	measure 'YoY Change' =
			VAR PY = [Actual PY]
			RETURN
			    IF ( NOT ISBLANK ( PY ), [Actual] - PY )
		formatString: #,0;(#,0);-
		displayFolder: 4. Time Intelligence
		lineageTag: af7b1419-c59d-45f5-a1a0-d3df69269d12

	/// YoY Change / ABS(Actual PY): positive = improvement (same sign rule as Variance).
	measure 'YoY %' = DIVIDE ( [YoY Change], ABS ( [Actual PY] ) )
		formatString: 0.0%;(0.0%);-
		displayFolder: 4. Time Intelligence
		lineageTag: d13bcdf4-f2d3-4957-bcab-4149abbd2b95

	/// Actual YTD for the same period last year.
	measure 'Actual YTD PY' = CALCULATE ( [Actual YTD], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4. Time Intelligence
		lineageTag: e63eb26d-8bcd-4b87-8a29-aabc93cc240c

	/// (Actual YTD - Actual YTD PY) / ABS(Actual YTD PY).
	measure 'YTD YoY %' =
			VAR PY = [Actual YTD PY]
			RETURN
			    IF ( NOT ISBLANK ( PY ), DIVIDE ( [Actual YTD] - PY, ABS ( PY ) ) )
		formatString: 0.0%;(0.0%);-
		displayFolder: 4. Time Intelligence
		lineageTag: cbab09a0-4120-4404-bd11-2ccadbd12b52

	/// Actual for the 12 months ending at the last date in context. Blank unless all 12 months have data.
	measure 'Actual Rolling 12M' =
			VAR Window =
			    DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -12, MONTH )
			VAR MonthsWithData =
			    CALCULATE (
			        DISTINCTCOUNT ( FactFinance[FinancePeriod] ),
			        Window,
			        REMOVEFILTERS ( DimAccount ),
			        REMOVEFILTERS ( DimDepartment ),
			        REMOVEFILTERS ( DimOrganization ),
			        REMOVEFILTERS ( DimScenario )
			    )
			RETURN
			    IF ( MonthsWithData = 12, CALCULATE ( [Actual], Window ) )
		formatString: #,0;(#,0);-
		displayFolder: 4. Time Intelligence
		lineageTag: f3fb44fe-84c4-4b5d-82c7-91d01aea7ebc

	/// TRUE when the matrix row is a repeated (ragged) level below the account's real depth. Used by all IS measures.
	measure 'IS Hide Row' =
			-- Deepest hierarchy level currently in scope (works whichever levels are placed on the rows)
			VAR BrowseDepth =
			    SWITCH (
			        TRUE (),
			        ISINSCOPE ( DimAccount[Level6AR] ) || ISINSCOPE ( DimAccount[Level6EN] ), 6,
			        ISINSCOPE ( DimAccount[Level5AR] ) || ISINSCOPE ( DimAccount[Level5EN] ), 5,
			        ISINSCOPE ( DimAccount[Level4AR] ) || ISINSCOPE ( DimAccount[Level4EN] ), 4,
			        ISINSCOPE ( DimAccount[Level3AR] ) || ISINSCOPE ( DimAccount[Level3EN] ), 3,
			        ISINSCOPE ( DimAccount[Level2AR] ) || ISINSCOPE ( DimAccount[Level2EN] ), 2,
			        ISINSCOPE ( DimAccount[Level1AR] ) || ISINSCOPE ( DimAccount[Level1EN] ), 1,
			        0
			    )
			VAR RowDepth = MAX ( DimAccount[AccountDepth] )
			RETURN
			    BrowseDepth > RowDepth
		isHidden
		displayFolder: 5. Income Statement
		lineageTag: 9cedecec-e8bf-4e30-acc9-9785537b4039

	/// [Actual (Budget Period)] for the income statement matrix (hides repeated ragged-hierarchy rows).
	measure 'IS Actual' = IF ( NOT [IS Hide Row], [Actual (Budget Period)] )
		formatString: #,0;(#,0);-
		displayFolder: 5. Income Statement
		lineageTag: 7c00d7ee-93a5-48a4-8752-531a8111f5ad

	/// [Budget] for the income statement matrix (hides repeated ragged-hierarchy rows).
	measure 'IS Budget' = IF ( NOT [IS Hide Row] && [IS In Budget Scope], [Budget] )
		formatString: #,0;(#,0);-
		displayFolder: 5. Income Statement
		lineageTag: 6fc8cab1-3a5b-43fe-910b-90326466f211

	/// [Rolling Forecast] for the income statement matrix (hides repeated ragged-hierarchy rows).
	measure 'IS Rolling Forecast' = IF ( NOT [IS Hide Row] && [IS In Budget Scope], [Rolling Forecast] )
		formatString: #,0;(#,0);-
		displayFolder: 5. Income Statement
		lineageTag: d729d61f-d6a9-4619-9edb-bba13425b1b6

	/// [Variance] for the income statement matrix (hides repeated ragged-hierarchy rows).
	measure 'IS Variance' = IF ( NOT [IS Hide Row] && [IS In Budget Scope], [Variance] )
		formatString: #,0;(#,0);-
		displayFolder: 5. Income Statement
		lineageTag: 20c62698-09c3-47d3-8c52-fc5ada27bfc1

	/// [Variance %] for the income statement matrix (hides repeated ragged-hierarchy rows).
	measure 'IS Variance %' = IF ( NOT [IS Hide Row] && [IS In Budget Scope], [Variance %] )
		formatString: 0.0%;(0.0%);-
		displayFolder: 5. Income Statement
		lineageTag: 10bb1881-1bb7-4b5b-8e14-144feb8193ce

	/// Operating profit, actual, budget months only.
	measure 'OP Actual' = CALCULATE ( [Actual (Budget Period)], DimAccount[Level2EN] = "Operating Profit" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: 74f32b64-a554-4864-b646-14c7c64d4d15

	/// Operating profit, budget.
	measure 'OP Budget' = CALCULATE ( [Budget], DimAccount[Level2EN] = "Operating Profit" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: d4879941-1d09-4534-9f3f-8c023a7465f4

	/// Operating profit: Actual - Budget.
	measure 'OP Variance' = CALCULATE ( [Variance], DimAccount[Level2EN] = "Operating Profit" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: e376235a-6839-48c6-b308-e51717e6c7c2

	/// Operating profit variance %.
	measure 'OP Variance %' = CALCULATE ( [Variance %], DimAccount[Level2EN] = "Operating Profit" )
		formatString: 0.0%;(0.0%);-
		displayFolder: 6. KPIs
		lineageTag: 90d57c3f-83bf-41f9-8877-52e6e55d09db

	/// Operating profit rolling forecast (cutoff from 'Forecast Cutoff').
	measure 'OP Rolling Forecast' = CALCULATE ( [Rolling Forecast], DimAccount[Level2EN] = "Operating Profit" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: 40b34bae-8eaa-44e1-a42e-86f746201d95

	/// Operating profit: Rolling Forecast - Budget.
	measure 'OP Forecast Variance' = CALCULATE ( [Forecast Variance], DimAccount[Level2EN] = "Operating Profit" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: 77a2c2b0-2288-4104-b24b-7ef9e36a846f

	/// Net sales, actual, budget months only.
	measure 'Net Sales Actual' = CALCULATE ( [Actual (Budget Period)], DimAccount[Level4EN] = "Net Sales" )
		formatString: #,0;(#,0);-
		displayFolder: 6. KPIs
		lineageTag: 360667e9-93a0-4001-84c4-b5143a7a67fd

	/// Net sales variance %.
	measure 'Net Sales Variance %' = CALCULATE ( [Variance %], DimAccount[Level4EN] = "Net Sales" )
		formatString: 0.0%;(0.0%);-
		displayFolder: 6. KPIs
		lineageTag: 59a02ea3-dfe2-4d0a-871a-effedcc073fe

	/// Font colour for [OP Variance]: green when favorable (>= 0), red when unfavorable.
	measure 'Color OP Variance' =
			VAR v = [OP Variance]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#374151", v >= 0, "#1E8449", "#C0392B" )
		isHidden
		displayFolder: 7. Formatting
		lineageTag: 91bc68fd-a93e-400a-8df2-14f3565c26a4

	/// Font colour for [OP Forecast Variance]: green when favorable (>= 0), red when unfavorable.
	measure 'Color OP Forecast Variance' =
			VAR v = [OP Forecast Variance]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#374151", v >= 0, "#1E8449", "#C0392B" )
		isHidden
		displayFolder: 7. Formatting
		lineageTag: bbaa1390-3e69-4d2a-aa85-9239776bbbf4

	/// Font colour for [IS Variance] / [IS Variance %]: green when favorable (>= 0), red when unfavorable.
	measure 'Color IS Variance' =
			VAR v = [IS Variance]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#374151", v >= 0, "#1E8449", "#C0392B" )
		isHidden
		displayFolder: 7. Formatting
		lineageTag: 6b0c3196-c6d2-49de-b2b9-3ab8b07a4fa4

	/// TRUE when every account in the current row lies under Operating Profit - the only part of the income statement that has a budget.
	/// Rows that include Other Income/Expense or Taxes (and Net Income) show Actual only, so Actual is never compared with a budget that excludes those lines.
	measure 'IS In Budget Scope' =
			ISEMPTY (
			    FILTER ( VALUES ( DimAccount[Level2EN] ), DimAccount[Level2EN] <> "Operating Profit" )
			)
		isHidden
		displayFolder: 5. Income Statement
		lineageTag: e1b3c50f-9311-4391-9ea8-2f697b09eac8

